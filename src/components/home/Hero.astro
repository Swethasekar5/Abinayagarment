---
import { url } from '../../lib/url';
/**
 * Hero: the transition video (yarn → panels → t-shirts → folded stacks) scrubbed with scroll.
 *
 * Desktop: full-bleed and pinned. Opens on the full first frame with the headline,
 *          plays the video as you scroll, ends on the full last frame with CTAs + facts.
 * Phones:  a CSS-sticky stage: headline on top, a square video window in the middle,
 *          CTA at the bottom; scrolling through the section plays the video.
 * Reduced motion / no JS: static layout with the finished image.
 *
 * Frames come from scripts/build-hero-sequence.mjs (see docs/redesign/HERO_ASSETS.md).
 */
import { Image } from 'astro:assets';
import Icon from '../site/Icon.astro';
import before from '../../assets/hero/before.png';
import after from '../../assets/hero/after.png';
import seq from '../../data/heroSequence.json';
import { site } from '../../data/site';

// frame URLs live under /public, so they need the deploy base path too
const hsManifest = Object.fromEntries(Object.entries(seq).map(([k, v]) => [k, { ...v, path: url(v.path) }]));

const imgProps = { widths: [828, 1280, 1920], sizes: '100vw' };
---

<section class="hs" data-hs data-seq={JSON.stringify(hsManifest)}>
  <div class="hs__track" data-hs-track>
    <div class="hs__stage">
      <div class="hs__intro" data-hs-intro>
        <div class="hs__intro-main">
          <p class="label hs__label" data-hero-in>(00) — Tiruppur knitwear house</p>
          <h1 class="hs__title" data-hero-in>
            <span class="hs__line">Stitched in</span>
            <span class="hs__line">Tiruppur.</span>
          </h1>
        </div>
        <div class="hs__intro-side" data-hero-in>
          <p class="hs__lead">Premium cotton apparel made and supplied in bulk, straight from the mill floor.</p>
          <a href="#quote" class="btn btn--primary" data-magnetic>Get wholesale price <Icon name="arrow" size={16} /></a>
        </div>
      </div>

      <div class="hs__media" data-hero-in data-hs-media>
        <div class="hs__before">
          <Image src={before} alt="Yarn cones and cut cotton panels on a workshop table" {...imgProps} loading="eager" fetchpriority="high" />
        </div>
        <canvas class="hs__canvas" data-hs-canvas aria-hidden="true"></canvas>
        <div class="hs__after" data-hs-after>
          <Image src={after} alt="Finished cotton t-shirts folded in neat stacks" {...imgProps} loading="lazy" />
        </div>
        <div class="hs__shade" data-hs-shade></div>
        <p class="tag hs__chapter" data-hs-chapter>01 · Combed cotton yarn</p>
        <p class="tag hs__chapter" data-hs-chapter>02 · Knitted &amp; dyed panels</p>
        <p class="tag hs__chapter" data-hs-chapter>03 · Stitched &amp; folded</p>
      </div>

      <p class="hs__cue mono" data-hero-in data-hs-cue>Scroll to stitch <Icon name="arrow-down" size={14} /></p>
    </div>
  </div>

  <div class="hs__final" data-hs-final>
    <div class="hs__final-row">
      <p class="hs__final-title" data-hs-final-item>Worn across <em>India</em>.</p>
      <div class="hs__final-side" data-hs-final-item>
        <p class="hs__final-lead">Knitted, dyed and stitched under one roof: for retailers, distributors and brands that can't afford to miss a season.</p>
        <div class="hs__final-ctas">
          <a href="#quote" class="btn btn--primary" data-magnetic>Get wholesale price <Icon name="arrow" size={16} /></a>
          <a href={url('/products')} class="btn btn--outline hs__ghost">Explore products</a>
        </div>
      </div>
    </div>
    <dl class="hs__facts" data-hs-final-item>
      {site.stats.slice(0, 3).map((s) => (
        <div class="hs__fact">
          <dt class="mono">{s.label}</dt>
          <dd>{s.value}{s.suffix}</dd>
        </div>
      ))}
      <div class="hs__fact">
        <dt class="mono">48-hr sample dispatch</dt>
        <dd>Pan-India</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  /* ============ STATIC LAYOUT (reduced motion, no JS) ============ */
  .hs {
    position: relative;
    z-index: 3;
    background: var(--cream);
    padding-top: clamp(6.5rem, 16vw, 8rem);
  }
  .hs__intro,
  .hs__final-row,
  .hs__facts {
    padding-inline: var(--gutter);
  }
  .hs__title {
    margin-top: 1.25rem;
    font-size: clamp(3.4rem, 13vw, 7rem);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.035em;
  }
  .hs__line {
    display: block;
  }
  .hs__intro-side,
  .hs__cue,
  .hs__chapter {
    display: none;
  }
  .hs__media {
    position: relative;
    margin-top: 2rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #2a241d;
  }
  .hs__before,
  .hs__after,
  .hs__shade {
    position: absolute;
    inset: 0;
  }
  .hs__before,
  .hs__canvas,
  .hs__shade {
    display: none;
  }
  .hs__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hs__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hs__final {
    padding-block: 2rem 1rem;
  }
  .hs__final-title {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 9vw, 4rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .hs__final-lead {
    margin-top: 1.25rem;
    max-width: 32rem;
    color: var(--ink-soft);
    font-size: var(--fs-lead);
  }
  .hs__final-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }
  .hs__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 1rem;
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }
  .hs__fact {
    display: flex;
    flex-direction: column-reverse;
    padding-left: 0.9rem;
    border-left: 2px solid var(--madder);
  }
  .hs__fact:nth-child(2) { border-color: var(--indigo); }
  .hs__fact:nth-child(3) { border-color: var(--sage); }
  .hs__fact:nth-child(4) { border-color: currentColor; }
  .hs__fact dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    line-height: 1.1;
  }
  .hs__fact dt {
    margin-top: 0.3rem;
    font-size: 0.64rem;
    opacity: 0.75;
  }

  /* ============ PHONE SCENE: sticky stage, square video window ============ */
  @media (max-width: 1023px) {
    :global(html.motion) .hs {
      padding-top: 0;
      background: var(--ink);
      color: var(--cream);
    }
    :global(html.motion) .hs__track {
      height: 230svh; /* 130svh of scroll plays the video */
    }
    :global(html.motion) .hs__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(1rem, 3svh, 1.75rem);
      padding: 76px 0 max(1.25rem, env(safe-area-inset-bottom));
      overflow: hidden;
    }
    :global(html.motion) .hs__intro {
      display: contents;
    }
    :global(html.motion) .hs__intro-main,
    :global(html.motion) .hs__intro-side {
      padding-inline: var(--gutter);
    }
    :global(html.motion) .hs__label {
      color: rgba(245, 241, 234, 0.7);
    }
    :global(html.motion) .hs__title {
      margin-top: 0.75rem;
      font-size: clamp(2.8rem, min(13vw, 7.5svh), 4.6rem);
    }
    :global(html.motion) .hs__media {
      order: 2;
      flex: none;
      align-self: center;
      margin: 0;
      width: min(100%, 46svh);
      aspect-ratio: 1;
    }
    /* same square window as the mobile frames (x ≈ 27–83% of the video) */
    :global(html.motion) .hs__media img {
      object-position: 61% 50%;
    }
    :global(html.motion) .hs__before {
      display: block;
    }
    :global(html.motion) .hs__canvas {
      display: block;
      visibility: hidden;
    }
    :global(html.motion) .hs__canvas.is-ready {
      visibility: visible;
    }
    :global(html.motion) .hs__after {
      opacity: 0;
    }
    :global(html.motion) .hs__chapter {
      display: inline-flex;
      position: absolute;
      left: 0.9rem;
      bottom: 0.9rem;
      z-index: 2;
      visibility: hidden;
    }
    :global(html.motion) .hs__intro-side {
      order: 3;
      display: grid;
      gap: 1rem;
      justify-items: start;
    }
    :global(html.motion) .hs__lead {
      color: rgba(245, 241, 234, 0.82);
      font-size: 0.98rem;
      line-height: 1.55;
    }
    :global(html.motion) .hs__final {
      background: var(--cream);
      color: var(--ink);
      padding-top: 3rem;
    }
  }
  /* short phones (e.g. iPhone SE): drop the small label so the stage breathes */
  @media (max-width: 1023px) and (max-height: 720px) {
    :global(html.motion) .hs__label {
      display: none;
    }
  }

  /* ============ DESKTOP SCENE: full-bleed, pinned ============ */
  @media (min-width: 1024px) {
    :global(html.motion) .hs {
      height: 100svh;
      padding: 0;
      overflow: hidden;
      background: #2a241d;
      color: var(--cream);
    }
    :global(html.motion) .hs__track,
    :global(html.motion) .hs__stage {
      position: absolute;
      inset: 0;
    }
    :global(html.motion) .hs__media {
      position: absolute;
      inset: 0;
      z-index: 0;
      margin: 0;
      aspect-ratio: auto;
    }
    :global(html.motion) .hs__before,
    :global(html.motion) .hs__shade {
      display: block;
    }
    :global(html.motion) .hs__canvas {
      display: block;
      visibility: hidden; /* shown once the first frame has loaded */
    }
    :global(html.motion) .hs__canvas.is-ready {
      visibility: visible;
    }
    :global(html.motion) .hs__after {
      opacity: 0;
    }
    /* legibility: dark at the top (nav) and bottom (copy), clear in the middle */
    :global(html.motion) .hs__shade {
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(23, 21, 18, 0.6) 0%, rgba(23, 21, 18, 0) 18%),
        linear-gradient(0deg, rgba(23, 21, 18, 0.88) 0%, rgba(23, 21, 18, 0.55) 26%, rgba(23, 21, 18, 0) 52%);
    }
    :global(html.motion) .hs__intro {
      position: absolute;
      left: 0;
      right: 0;
      bottom: clamp(1.75rem, 6svh, 3.5rem);
      z-index: 2;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 3rem;
    }
    :global(html.motion) .hs__label {
      color: rgba(245, 241, 234, 0.75);
    }
    :global(html.motion) .hs__title {
      font-size: clamp(4.5rem, min(9.5vw, 16svh), 10.5rem);
      line-height: 0.9;
      margin-top: 1.25rem;
    }
    :global(html.motion) .hs__intro-side {
      display: grid;
      gap: 1.5rem;
      justify-items: start;
      width: min(24rem, 30vw);
      padding-bottom: 0.6rem;
    }
    :global(html.motion) .hs__lead {
      color: rgba(245, 241, 234, 0.85);
      font-size: 1.05rem;
      line-height: 1.6;
    }
    :global(html.motion) .hs__cue {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      position: absolute;
      right: var(--gutter);
      top: clamp(6.5rem, 13svh, 8rem);
      z-index: 2;
      font-size: 0.68rem;
      color: rgba(245, 241, 234, 0.8);
    }
    :global(html.motion) .hs__chapter {
      display: inline-flex;
      position: absolute;
      left: var(--gutter);
      top: 50%;
      z-index: 2;
      visibility: hidden;
    }
    :global(html.motion) .hs__final {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 3;
      padding: 0 0 clamp(1.25rem, 3svh, 2rem);
      visibility: hidden;
    }
    :global(html.motion) .hs__final-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 3rem;
    }
    :global(html.motion) .hs__final-title {
      font-size: clamp(3.6rem, min(7vw, 12svh), 8rem);
      white-space: nowrap;
    }
    :global(html.motion) .hs__final-title em {
      color: var(--sage-tint);
    }
    :global(html.motion) .hs__final-side {
      width: min(26rem, 32vw);
    }
    :global(html.motion) .hs__final-lead {
      margin-top: 0;
      font-size: 1rem;
      color: rgba(245, 241, 234, 0.85);
    }
    :global(html.motion) .hs__final-ctas {
      margin-top: 1.25rem;
    }
    :global(html.motion) .hs__ghost {
      border-color: rgba(245, 241, 234, 0.7);
      color: var(--cream);
    }
    :global(html.motion) .hs__ghost:hover {
      background: var(--cream);
      color: var(--ink);
    }
    :global(html.motion) .hs__facts {
      grid-template-columns: repeat(4, 1fr);
      margin-top: clamp(1.25rem, 3svh, 2rem);
      padding-top: 1rem;
      border-top-color: rgba(245, 241, 234, 0.25);
    }
    :global(html.motion) .hs__fact:nth-child(2) { border-color: #8f9bd0; }

    /* static desktop (reduced motion): side-by-side instead of stacked */
    :global(html:not(.motion)) .hs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'intro media' 'final media';
      align-content: start;
      column-gap: 3rem;
      padding-right: var(--gutter);
      padding-bottom: 4rem;
    }
    :global(html:not(.motion)) .hs__track,
    :global(html:not(.motion)) .hs__stage {
      display: contents;
    }
    :global(html:not(.motion)) .hs__intro { grid-area: intro; }
    :global(html:not(.motion)) .hs__final { grid-area: final; }
    :global(html:not(.motion)) .hs__media { grid-area: media; margin: 0; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, SplitText, MQ } from '../../scripts/motion/core';
  import { createSequence } from '../../scripts/motion/sequence';

  type Manifest = { count: number; path: string; pad: number };
  const hero = document.querySelector<HTMLElement>('[data-hs]')!;
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const manifests = JSON.parse(hero.dataset.seq!) as { desktop: Manifest; mobile: Manifest };
  const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
  const qa = <T extends Element = HTMLElement>(s: string) => Array.from(hero.querySelectorAll<T>(s));
  const setNavOverHero = (on: boolean) => nav?.classList.toggle('is-over-hero', on);

  /**
   * Light nav whenever the dark hero stage is actually underneath it.
   * Computed from geometry on every scroll, so it can't desync at scroll
   * boundaries (e.g. scrolling back to the very top, iOS bounce, resizes).
   */
  function trackNavOverHero() {
    const stage = q('.hs__stage');
    const navH = () => nav?.offsetHeight ?? 72;
    let raf = 0;
    const sync = () => {
      raf = 0;
      const r = stage.getBoundingClientRect();
      setNavOverHero(r.top <= navH() / 2 && r.bottom >= navH());
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(sync);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    ScrollTrigger.addEventListener('refresh', sync);
    sync();
    return () => {
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onScroll);
      ScrollTrigger.removeEventListener('refresh', sync);
      cancelAnimationFrame(raf);
      setNavOverHero(false);
    };
  }

  /** Canvas frame player for one variant; frames start loading after the page has loaded. */
  function setupSequence(m: Manifest) {
    const canvas = q<HTMLCanvasElement>('[data-hs-canvas]');
    const seq = createSequence(canvas, { count: m.count, url: (i) => m.path.replace('{i}', String(i).padStart(m.pad, '0')) });
    let cancelled = false;
    const start = () => {
      if (cancelled) return;
      seq.resize();
      seq.preload().then(() => {
        canvas.classList.add('is-ready');
        seq.resize();
      });
    };
    if (document.readyState === 'complete') setTimeout(start, 150);
    else window.addEventListener('load', () => setTimeout(start, 150), { once: true });
    const onRefresh = () => seq.resize();
    ScrollTrigger.addEventListener('refresh', onRefresh);
    return {
      seq,
      count: m.count,
      cleanup: () => {
        cancelled = true;
        canvas.classList.remove('is-ready');
        ScrollTrigger.removeEventListener('refresh', onRefresh);
      },
    };
  }

  const chapter = (tl: gsap.core.Timeline, el: HTMLElement, at: number, hold: number) =>
    tl
      .fromTo(el, { autoAlpha: 0, y: 20 }, { autoAlpha: 1, y: 0, duration: 0.4 }, at)
      .to(el, { autoAlpha: 0, y: -20, duration: 0.4 }, at + hold);

  gsap.matchMedia().add({ desktop: MQ.desktop, mobile: MQ.mobile }, (ctx) => {
    (window as any).__heroReady = true;
    const split = SplitText.create(qa('.hs__line'), { type: 'lines', mask: 'lines' });
    const media = q('[data-hs-media]');
    const after = q('[data-hs-after]');
    const chapters = qa('[data-hs-chapter]');
    const playhead = { frame: 0 };

    // ---------- phones: sticky stage, square video window ----------
    if (ctx.conditions!.mobile) {
      const { seq, count, cleanup } = setupSequence(manifests.mobile);
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: q('[data-hs-track]'),
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.5,
        },
      });
      const stopNav = trackNavOverHero();
      tl.to(playhead, { frame: count - 1, duration: 10, onUpdate: () => seq.draw(playhead.frame) }, 0).fromTo(after, { opacity: 0 }, { opacity: 1, duration: 0.3 }, 9.7);
      chapter(tl, chapters[0], 0.4, 2.6);
      chapter(tl, chapters[1], 3.6, 2.8);
      chapter(tl, chapters[2], 7.0, 2.6);

      gsap
        .timeline({ defaults: { ease: 'expo.out' }, delay: 0.1 })
        .set(qa('[data-hero-in]'), { visibility: 'visible' })
        .from(split.lines, { yPercent: 110, duration: 1.2, stagger: 0.1 })
        .fromTo(media, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.4 }, 0.2)
        .from(q('.hs__intro-side'), { y: 24, autoAlpha: 0, duration: 1 }, 0.5);

      return () => {
        stopNav();
        cleanup();
        split.revert();
      };
    }

    // ---------- desktop: full-bleed pinned scroll video ----------
    const { seq, count, cleanup } = setupSequence(manifests.desktop);
    const shade = q('[data-hs-shade]');
    const intro = q('[data-hs-intro]');
    const cue = q('[data-hs-cue]');
    const finalItems = qa('[data-hs-final-item]');

    const scene = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: hero,
        start: 'top top',
        end: '+=300%',
        scrub: 0.8,
        pin: true,
        anticipatePin: 1,
      },
    });
    scene
      // 1: opening copy clears, shading lifts so the video plays unobstructed
      .to(intro, { autoAlpha: 0, y: -50, duration: 1 }, 0)
      .to(cue, { autoAlpha: 0, duration: 0.5 }, 0)
      .fromTo(shade, { opacity: 1 }, { opacity: 0.35, duration: 1 }, 0)
      // 2: the video plays with scroll
      .to(playhead, { frame: count - 1, duration: 7, onUpdate: () => seq.draw(playhead.frame) }, 0.6)
      .fromTo(after, { opacity: 0 }, { opacity: 1, duration: 0.3 }, 7.4) // fallback if frames didn't load
      // 3: closing copy over the finished frame
      .to(shade, { opacity: 1, duration: 1 }, 7.5)
      .set(q('[data-hs-final]'), { visibility: 'visible' }, 7.6)
      .fromTo(finalItems, { y: 50, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 1, stagger: 0.18, ease: 'power3.out' }, 7.7)
      .to({}, { duration: 1.2 }); // hold the final frame before unpinning
    chapter(scene, chapters[0], 1.0, 1.6);
    chapter(scene, chapters[1], 3.1, 1.8);
    chapter(scene, chapters[2], 5.4, 1.6);
    const stopNav = trackNavOverHero();

    gsap
      .timeline({ defaults: { ease: 'expo.out' }, delay: 0.1 })
      .set(qa('[data-hero-in]'), { visibility: 'visible' })
      .fromTo(media, { scale: 1.12, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 2.2 }, 0)
      .from(split.lines, { yPercent: 110, duration: 1.3, stagger: 0.14 }, 0.35)
      .from([q('.hs__label'), q('.hs__intro-side'), cue], { y: 24, autoAlpha: 0, duration: 1, stagger: 0.1 }, 0.7);

    return () => {
      stopNav();
      cleanup();
      split.revert();
    };
  });
</script>
