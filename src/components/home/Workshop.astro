---
import { url } from '../../lib/url';
import { Image } from 'astro:assets';
import { photos } from '../../assets/photos';

const shots = [
  { img: photos.factoryFabricInspection, cap: '01 · Fabric inspection', cls: 'w--a', speed: 20 },
  { img: photos.fabricRollsRacks, cap: '02 · Fabric lots', cls: 'w--b', speed: 30 },
  { img: photos.handsFoldingTee, cap: '03 · Finishing', cls: 'w--c', speed: 35 },
  { img: photos.circularKnittingMachine, cap: '04 · Knitting floor', cls: 'w--d', speed: 70 },
  { img: photos.qcMeasuringTape, cap: '05 · Measurement check', cls: 'w--e', speed: 30 },
  { img: photos.cartonsDispatch, cap: '06 · Freight dispatch', cls: 'w--f', speed: 50 },
];
---

<section class="section workshop">
  <div class="container">
    <div class="workshop__head">
      <p class="label label--light">(07) — Inside the workshop</p>
      <h2 class="workshop__title">Crafted by hand, measured by <em>millimetres</em>.</h2>
    </div>

    <div class="workshop__collage">
      {shots.map((s) => (
        <figure class:list={['w', s.cls]} data-speed={s.speed}>
          <div class="w__frame" data-clip-reveal>
            <Image src={s.img} alt={s.cap.replace(/^\d+ · /, '')} widths={[400, 640, 900]} sizes="(min-width: 1024px) 34vw, 90vw" />
          </div>
          <figcaption class="mono">{s.cap}</figcaption>
        </figure>
      ))}
    </div>

    <div class="workshop__foot">
      <a href={url('/gallery')} class="stitch-link">See full gallery →</a>
    </div>
  </div>
</section>

<style>
  .workshop {
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
  }
  .workshop__head {
    display: grid;
    gap: 1.5rem;
    max-width: 52rem;
  }
  .workshop__title {
    font-size: var(--fs-h2);
    font-weight: 300;
  }
  .workshop__title em {
    color: var(--sage-tint);
  }

  .workshop__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: clamp(60px, 7vw, 100px);
    gap: 1.25rem;
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .w {
    margin: 0;
  }
  .w__frame {
    height: calc(100% - 2rem);
    overflow: hidden;
  }
  .w img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92);
    transition: filter 0.6s;
  }
  .w:hover img {
    filter: saturate(1.1);
  }
  .w figcaption {
    margin-top: 0.6rem;
    font-size: 0.64rem;
    color: rgba(245, 241, 234, 0.55);
  }
  /* editorial, uneven placement */
  .w--a { grid-column: 1 / span 6; grid-row: 1 / span 5; }
  .w--b { grid-column: 8 / span 4; grid-row: 2 / span 4; }
  .w--c { grid-column: 2 / span 3; grid-row: 7 / span 3; }
  .w--d { grid-column: 6 / span 6; grid-row: 7 / span 5; }
  .w--e { grid-column: 1 / span 4; grid-row: 11 / span 4; }
  .w--f { grid-column: 7 / span 4; grid-row: 13 / span 3; }

  .workshop__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: 2rem;
  }

  @media (max-width: 760px) {
    .workshop__collage {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: auto;
    }
    .w {
      grid-column: auto !important;
      grid-row: auto !important;
    }
    .w--a,
    .w--d {
      grid-column: 1 / -1 !important;
    }
    .w__frame {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
