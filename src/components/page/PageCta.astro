---
import { url } from '../../lib/url';
/** Closing call-to-action band shared by inner pages: inquiry, WhatsApp and call. */
import Icon from '../site/Icon.astro';
import { site, waLink } from '../../data/site';

interface Props {
  label?: string;
  title: string;
  text: string;
  primary?: { href: string; label: string };
}
const {
  label = 'Wholesale inquiries',
  title,
  text,
  primary = { href: url('/contact-us'), label: 'Send an inquiry' },
} = Astro.props;
---

<section class="section cta" data-cta>
  <div class="container">
    <div class="cta__panel" data-cta-panel>
      <svg class="cta__thread" viewBox="0 0 900 260" preserveAspectRatio="none" aria-hidden="true">
        <path data-cta-thread vector-effect="non-scaling-stroke" d="M -20 210 C 140 210, 210 60, 340 90 C 450 115, 420 210, 520 200 C 640 188, 660 40, 780 52 C 860 60, 880 120, 930 110"></path>
      </svg>
      <div class="cta__copy">
        <p class="label label--light">{label}</p>
        <h2 class="cta__title" data-split set:html={title} />
        <p class="cta__text">{text}</p>
      </div>
      <div class="cta__actions">
        <a href={primary.href} class="btn btn--cream" data-magnetic>{primary.label} <Icon name="arrow" size={16} /></a>
        <a href={waLink()} target="_blank" rel="noopener" class="btn cta__wa"><Icon name="whatsapp" size={18} /> Chat on WhatsApp</a>
        <a href={site.phoneHref} class="cta__call mono"><Icon name="phone" size={15} /> {site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(5rem, 9vw, 8rem);
  }
  .cta__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2.5rem, 6vw, 5.5rem);
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
  }
  .cta__thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.9;
  }
  .cta__thread path {
    fill: none;
    stroke: var(--madder);
    stroke-width: 2;
    stroke-dasharray: 8 7;
    stroke-linecap: round;
  }
  .cta__copy,
  .cta__actions {
    position: relative;
  }
  .cta__title {
    margin-block: 1.25rem 1.25rem;
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
  }
  .cta__title :global(em) {
    color: #aab4d6;
  }
  .cta__text {
    max-width: 36rem;
    color: rgba(245, 241, 234, 0.72);
    font-size: var(--fs-lead);
  }
  .cta__actions {
    display: grid;
    gap: 0.85rem;
    justify-items: stretch;
  }
  .cta__wa {
    border-color: rgba(245, 241, 234, 0.3);
    color: var(--cream);
  }
  .cta__wa svg {
    color: var(--whatsapp);
  }
  .cta__wa:hover {
    background: rgba(245, 241, 234, 0.08);
  }
  .cta__call {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding-top: 0.5rem;
    color: rgba(245, 241, 234, 0.7);
  }
  .cta__call:hover {
    color: var(--cream);
  }

  @media (max-width: 900px) {
    .cta__panel {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>

<script>
  import { gsap, drawable, MQ } from '../../scripts/motion/core';

  gsap.matchMedia().add(MQ.motion, () => {
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((root) => {
      const thread = drawable(root.querySelector<SVGPathElement>('[data-cta-thread]')!);
      gsap.to(thread, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: { trigger: root, start: 'top 85%', end: 'center 45%', scrub: 0.6 },
      });
      gsap.fromTo(
        root.querySelector('[data-cta-panel]'),
        { clipPath: 'inset(10% 4% 10% 4%)' },
        {
          clipPath: 'inset(0% 0% 0% 0%)',
          ease: 'none',
          scrollTrigger: { trigger: root, start: 'top bottom', end: 'top 35%', scrub: 0.5 },
        },
      );
    });
  });
</script>
