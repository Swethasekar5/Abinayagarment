---
/** Abinaya "A" monogram: a continuous thread with a needle crossbar (from the Stitch logo suite). */
interface Props {
  size?: number;
  thread?: string; // colour of the thread body
  needle?: string;
  class?: string;
}
const { size = 40, thread = 'currentColor', needle = 'currentColor', class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size * 0.86} viewBox="10 6 132 116" fill="none" aria-hidden="true">
  <path
    class="mono-thread"
    d="M 28 116 C 22 116 16 110 16 102 C 16 90 28 84 38 72 L 68 18 C 70.5 13.5 73.5 11 77 11 C 80.5 11 83.5 13.5 86 18 L 118 78 C 126 92 136 98 136 107 C 136 113 130 117 124 117 C 116 117 112 110 110 102 L 97 74"
    stroke={thread}
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="25" cy="103" r="7" stroke={thread} stroke-width="3.4" stroke-dasharray="2.5 2.5"></circle>
  <g class="mono-needle">
    <path d="M 40 68 L 112 68" stroke={needle} stroke-width="4.6" stroke-linecap="round"></path>
    <ellipse cx="46" cy="68" rx="4.5" ry="1.6" fill="var(--cream)" stroke={needle} stroke-width="1.8"></ellipse>
    <path d="M 112 68 L 121 68" stroke={needle} stroke-width="2" stroke-linecap="round"></path>
    <path d="M 46 68 C 42 62 38 60 34 65 C 30 71 36 78 44 76 L 52 74" stroke={needle} stroke-width="2.4" stroke-dasharray="2 2"></path>
  </g>
</svg>
