---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/site/Icon.astro';
import { photos } from '../assets/photos';
import { categories, site, waLink } from '../data/site';

const channels = [
  { k: 'WhatsApp', note: 'Fastest reply', v: site.phone, href: waLink(), icon: 'whatsapp', external: true },
  { k: 'Phone', note: site.hours, v: site.phone, href: site.phoneHref, icon: 'phone', external: false },
  { k: 'Email', note: site.replyTime, v: site.email, href: `mailto:${site.email}`, icon: 'mail', external: false },
  { k: 'Visit', note: 'Open in Google Maps', v: `${site.address.line1}, ${site.address.city}`, href: site.mapUrl, icon: 'pin', external: true },
] as const;

const promises = [
  { title: 'Quick response', text: 'We respond to inquiries within 24 hours during business days.' },
  { title: 'Consultation', text: 'Personalised guidance on the right products and quantities for your bulk order.' },
  { title: 'Expert support', text: 'Help with products, pricing and customisation options at every step.' },
];

const faqs = [
  {
    q: 'How do I place a bulk order?',
    a: 'Fill out the inquiry form, or contact us on WhatsApp or by phone with your requirements. Our team will send you a quotation and help you through the ordering process.',
  },
  {
    q: 'What is the minimum order quantity?',
    a: 'It depends on the product and any customisation. Contact us with your requirement and we will share the MOQ details. We work with businesses of all sizes.',
  },
  {
    q: 'Can you customise products?',
    a: 'Yes. We offer custom printing, branding and designs on our cotton apparel. Ask us about customisation for your order.',
  },
  {
    q: 'What payment methods do you accept?',
    a: 'We offer flexible payment terms for wholesale orders. Contact us to discuss the payment options that work for your business.',
  },
];

const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${site.address.line1}, ${site.address.city}, ${site.address.state}`)}&z=14&output=embed`;
---

<SiteLayout
  title="Contact us"
  description="Contact Abinaya Garment Shop in Tiruppur for wholesale cotton apparel: WhatsApp, phone, email or send an inquiry for bulk pricing."
>
  <section class="talk" data-talk>
    <div class="container">
      <div class="talk__top" data-page-in>
        <p class="label">(01) — Contact</p>
        <p class="mono talk__crumb">Wholesale &amp; bulk orders · {site.address.city}</p>
      </div>

      <div class="talk__grid">
        <!-- dark panel: direct channels -->
        <aside class="panel" data-panel>
          <div class="panel__head">
            <p class="mono panel__k">Direct to our team</p>
            <span class="mono panel__live"><span class="panel__dot"></span> {site.replyTime}</span>
          </div>
          <h1 class="panel__title" data-split="now">Talk to <em>us</em>.</h1>
          <p class="panel__text" data-page-in>
            We're here to help with your wholesale and bulk order requirements. Reach the team directly: no forms
            needed if you'd rather chat.
          </p>
          <figure class="panel__photo" data-page-in>
            <Image src={photos.inspectorsJerseyTable} alt="Inspectors checking jersey fabric" widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 92vw" loading="eager" />
            <figcaption class="mono">Quality check · {site.address.city}</figcaption>
          </figure>
          <ul class="channels">
            {channels.map((c, i) => (
              <li data-page-in>
                <a href={c.href} class="channel" {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  <span class="channel__meta mono">
                    <span>[0{i + 1}] {c.k}</span>
                    <span class="channel__note">{c.note}</span>
                  </span>
                  <span class="channel__v">{c.v}</span>
                  <span class="channel__icon"><Icon name={c.icon} size={18} /></span>
                </a>
              </li>
            ))}
          </ul>
          <p class="panel__hours mono"><Icon name="clock" size={15} /> {site.hours}</p>
        </aside>

        <!-- inquiry form -->
        <div class="form-card" data-form-card data-page-in>
          <div class="form-card__head">
            <p class="label">(02) — Inquiry</p>
            <p class="mono form-card__ref">Bulk &amp; wholesale</p>
          </div>
          <h2 class="form-card__title">Send us an <em>inquiry</em>.</h2>
          <p class="form-card__text">
            Tell us what you need. Pressing send opens WhatsApp with your details filled in, ready to send to our team.
          </p>

          <form class="iform" data-iform novalidate>
            <label class="field">
              <span class="mono">Your name *</span>
              <input name="name" required autocomplete="name" placeholder="Full name" />
            </label>
            <label class="field">
              <span class="mono">Company / shop *</span>
              <input name="company" required autocomplete="organization" placeholder="Business name" />
            </label>
            <label class="field">
              <span class="mono">Phone / WhatsApp *</span>
              <input name="phone" type="tel" required autocomplete="tel" placeholder="+91" />
            </label>
            <label class="field">
              <span class="mono">Email *</span>
              <input name="email" type="email" required autocomplete="email" placeholder="you@business.com" />
            </label>
            <label class="field">
              <span class="mono">City *</span>
              <input name="city" required autocomplete="address-level2" placeholder="Your city" />
            </label>
            <label class="field">
              <span class="mono">Product *</span>
              <select name="product" required data-product-select>
                <option value="">Select a product</option>
                {categories.map((c) => <option value={c}>{c}</option>)}
                <option value="Multiple products">Multiple products</option>
              </select>
            </label>
            <label class="field field--wide">
              <span class="mono">Required quantity *</span>
              <input name="qty" required placeholder="e.g. 500 pieces, 1000+ units" />
            </label>
            <label class="field field--wide">
              <span class="mono">Message *</span>
              <textarea name="message" rows="4" required placeholder="Sizes, colours, printing or anything else we should know"></textarea>
            </label>
            <label class="consent field--wide">
              <input type="checkbox" name="consent" required />
              <span>I agree to be contacted about my inquiry.</span>
            </label>
            <p class="iform__error field--wide" data-iform-error role="alert" hidden>Please fill in the highlighted fields.</p>
            <div class="iform__submit field--wide">
              <button class="btn btn--primary" type="submit" data-magnetic>
                Send inquiry <Icon name="arrow" size={16} />
              </button>
              <p class="mono iform__note">Opens WhatsApp · {site.replyTime}</p>
            </div>
          </form>

          <div class="sent" data-sent hidden tabindex="-1">
            <svg class="sent__mark" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="32" cy="32" r="29" pathLength="1"></circle>
              <path d="M19 33l9 9 17-19" pathLength="1"></path>
            </svg>
            <p class="sent__title">Almost there.</p>
            <p>
              Press <strong>Send</strong> in the WhatsApp window that just opened, and we'll get back to you within 24
              hours. If WhatsApp didn't open, call us on <a href={site.phoneHref}>{site.phone}</a>.
            </p>
            <button type="button" class="btn btn--outline" data-sent-again>Send another inquiry</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- map -->
  <section class="section find">
    <div class="container">
      <div class="find__head">
        <div>
          <p class="label">(03) — Find us</p>
          <h2 class="find__title" data-split>Find us in <em>Tiruppur</em>.</h2>
        </div>
        <p class="mono find__addr">{site.address.line1}<br />{site.address.city}, {site.address.state}</p>
      </div>
      <div class="map" data-clip-reveal>
        <iframe
          src={mapSrc}
          title={`Map: ${site.name}, ${site.address.line1}, ${site.address.city}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div class="map__card">
          <p class="mono map__k">Visiting</p>
          <p class="map__name">{site.name}</p>
          <p class="map__addr">{site.address.line1}, {site.address.city}, {site.address.state}, {site.address.country}</p>
          <p class="mono map__hours">{site.hours}</p>
          <a href={site.mapUrl} target="_blank" rel="noopener" class="btn btn--ink map__btn"><Icon name="pin" size={16} /> Get directions</a>
        </div>
      </div>
      <ul class="promises" data-reveal="children">
        {promises.map((p, i) => (
          <li>
            <span class="mono promises__n">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- faq -->
  <section class="section faq">
    <div class="container faq__grid">
      <div class="faq__head">
        <p class="label">(04) — Quick answers</p>
        <h2 class="faq__title" data-split>Common questions about <em>ordering</em>.</h2>
        <p class="lead">Can't find your answer? Ask us directly.</p>
        <a href={waLink('Hello Abinaya Garment Shop, I have a quick question about your products.')} target="_blank" rel="noopener" class="btn btn--ink">
          <Icon name="whatsapp" size={18} /> Ask on WhatsApp
        </a>
      </div>
      <div class="faq__list" data-reveal="children">
        {faqs.map((f, i) => (
          <details class="qa" data-qa open={i === 0}>
            <summary>
              <span class="mono qa__n">0{i + 1}</span>
              <span class="qa__q">{f.q}</span>
              <span class="qa__plus" aria-hidden="true"></span>
            </summary>
            <div class="qa__a" data-qa-body><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  /* ---------- talk (hero) ---------- */
  .talk {
    padding-top: calc(88px + clamp(2rem, 5vw, 4rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .talk__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    background: repeating-linear-gradient(90deg, var(--madder) 0 9px, transparent 9px 15px) bottom / 100% 2px no-repeat;
  }
  .talk__crumb {
    color: var(--ink-soft);
  }
  .talk__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: start;
  }

  .panel {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--ink);
    color: rgba(245, 241, 234, 0.78);
  }
  .panel__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.62rem;
  }
  .panel__k {
    color: rgba(245, 241, 234, 0.6);
  }
  .panel__live {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid rgba(245, 241, 234, 0.2);
    font-size: 0.58rem;
  }
  .panel__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--whatsapp);
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6);
    animation: pulse 2.2s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }
  .panel__title {
    font-size: clamp(3.6rem, 7vw, 6.5rem);
    font-weight: 300;
    line-height: 0.92;
    color: var(--cream);
  }
  .panel__title :global(em) {
    color: #e3a491;
  }
  .panel__photo {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .panel__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .panel__photo figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.5rem 0.75rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    color: var(--cream);
    font-size: 0.58rem;
  }
  .channels {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .channel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(245, 241, 234, 0.14);
    background: rgba(245, 241, 234, 0.04);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }
  .channel:hover {
    background: rgba(245, 241, 234, 0.09);
    border-color: rgba(245, 241, 234, 0.35);
  }
  .channel__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.56rem;
    color: rgba(245, 241, 234, 0.55);
  }
  .channel__note {
    text-align: right;
  }
  .channel__v {
    grid-column: 1;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    font-weight: 500;
    color: var(--cream);
    overflow-wrap: anywhere;
  }
  .channel__icon {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid rgba(245, 241, 234, 0.25);
    color: var(--cream);
    transition: transform 0.4s var(--ease-out);
  }
  .channels li:first-child .channel__icon {
    color: var(--whatsapp);
  }
  .channel:hover .channel__icon {
    transform: rotate(-12deg) scale(1.08);
  }
  .panel__hours {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6rem;
    color: rgba(245, 241, 234, 0.55);
  }

  /* ---------- form card ---------- */
  .form-card {
    padding: clamp(1.5rem, 3.5vw, 3rem);
    background: var(--paper);
    border: 1px solid var(--hairline);
    box-shadow: 0 40px 80px -50px rgba(23, 21, 18, 0.35);
  }
  .form-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .form-card__ref {
    font-size: 0.6rem;
    color: var(--madder);
  }
  .form-card__title {
    margin-top: 1.25rem;
    font-size: clamp(2.2rem, 3.8vw, 3.5rem);
    font-weight: 300;
  }
  .form-card__text {
    max-width: 34rem;
    margin-top: 0.85rem;
    color: var(--ink-soft);
  }
  .iform {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 1.75rem;
    margin-top: 2.25rem;
  }
  .iform[hidden] {
    display: none;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field .mono {
    font-size: 0.62rem;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.55rem 0 0.65rem;
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent no-repeat left bottom / 0% 2px;
    background-image: repeating-linear-gradient(90deg, var(--madder) 0 6px, transparent 6px 10px);
    font: inherit;
    font-size: 1.02rem;
    color: var(--ink);
    transition: background-size 0.6s var(--ease-out);
    appearance: none;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field select {
    cursor: pointer;
    background-image:
      repeating-linear-gradient(90deg, var(--madder) 0 6px, transparent 6px 10px),
      linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-size:
      0% 2px,
      5px 5px,
      5px 5px;
    background-position:
      left bottom,
      calc(100% - 10px) 50%,
      calc(100% - 5px) 50%;
    background-repeat: no-repeat;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    background-size: 100% 2px;
    border-bottom-color: transparent;
  }
  .field select:focus {
    outline: none;
    background-size:
      100% 2px,
      5px 5px,
      5px 5px;
    border-bottom-color: transparent;
  }
  .field [aria-invalid='true'] {
    border-bottom-color: var(--madder);
  }
  .field:has([aria-invalid='true']) .mono {
    color: var(--madder);
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.2rem;
    accent-color: var(--indigo);
  }
  .consent:has([aria-invalid='true']) {
    color: var(--madder);
  }
  .iform__error {
    color: var(--madder);
  }
  .iform__submit {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .iform__note {
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  .sent {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 2rem;
    padding: 2rem;
    border: 1px dashed var(--sage);
    background: var(--sage-tint);
  }
  .sent[hidden] {
    display: none;
  }
  .sent:focus {
    outline: none;
  }
  .sent__mark {
    width: 3.5rem;
    height: 3.5rem;
    fill: none;
    stroke: var(--indigo);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sent__mark * {
    stroke-dasharray: 1;
  }
  .sent__title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
  }
  .sent a {
    text-decoration: underline;
  }

  /* ---------- map ---------- */
  .find__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .find__title {
    margin-top: 1.5rem;
    font-size: var(--fs-h2);
    font-weight: 300;
  }
  .find__addr {
    text-align: right;
    color: var(--ink-soft);
    line-height: 1.8;
  }
  .map {
    position: relative;
    height: clamp(26rem, 55vw, 36rem);
    background: var(--sage-tint);
    border: 1px solid var(--hairline);
    overflow: hidden;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(1) sepia(0.28) contrast(1.02) brightness(1.02);
  }
  .map__card {
    position: absolute;
    left: clamp(1rem, 2vw, 1.5rem);
    bottom: clamp(1rem, 2vw, 1.5rem);
    display: grid;
    gap: 0.4rem;
    width: min(22rem, calc(100% - 2rem));
    padding: 1.4rem;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 0 20px 40px -20px rgba(23, 21, 18, 0.4);
  }
  .map__k {
    font-size: 0.6rem;
    color: var(--madder);
  }
  .map__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .map__addr {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .map__hours {
    font-size: 0.6rem;
    color: var(--ink-soft);
  }
  .map__btn {
    margin-top: 0.6rem;
  }
  .promises {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--ink);
  }
  .promises li {
    padding: 1.5rem clamp(1rem, 2vw, 2rem) 0 0;
  }
  .promises li + li {
    padding-left: clamp(1rem, 2vw, 2rem);
    border-left: 1px dashed var(--hairline);
  }
  .promises__n {
    color: var(--madder);
  }
  .promises h3 {
    margin: 0.75rem 0 0.5rem;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
  }
  .promises p {
    color: var(--ink-soft);
  }

  /* ---------- faq ---------- */
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .faq__head {
    position: sticky;
    top: 120px;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .faq__title {
    font-size: clamp(2.4rem, 4.4vw, 4rem);
    font-weight: 300;
  }
  .faq__list {
    border-top: 1px solid var(--ink);
  }
  .qa {
    border-bottom: 1px solid var(--hairline);
  }
  .qa summary {
    display: grid;
    grid-template-columns: 2.5rem 1fr 1.5rem;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa__n {
    color: var(--madder);
  }
  .qa__q {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.2;
  }
  .qa__plus {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
  }
  .qa__plus::before,
  .qa__plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.45s var(--ease-out);
  }
  .qa__plus::after {
    transform: rotate(90deg);
  }
  .qa[open] .qa__plus::after {
    transform: rotate(0deg);
  }
  .qa summary:hover .qa__q {
    color: var(--indigo);
  }
  .qa__a {
    overflow: hidden;
  }
  .qa__a p {
    padding: 0 2.5rem 1.6rem 3.5rem;
    color: var(--ink-soft);
  }

  @media (max-width: 1023px) {
    .talk__grid,
    .faq__grid {
      grid-template-columns: 1fr;
    }
    .panel,
    .faq__head {
      position: static;
    }
  }
  @media (max-width: 680px) {
    .talk {
      padding-top: calc(76px + 1.75rem);
    }
    .talk__top {
      flex-direction: column;
      gap: 0.4rem;
    }
    .iform {
      grid-template-columns: 1fr;
    }
    .channel__meta {
      flex-direction: column;
      gap: 0.1rem;
    }
    .channel__note {
      text-align: left;
    }
    .channel__v {
      font-size: 0.98rem;
    }
    .find__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .find__addr {
      text-align: left;
    }
    .map {
      height: auto;
      display: flex;
      flex-direction: column;
    }
    .map iframe {
      height: 20rem;
    }
    .map__card {
      position: static;
      width: auto;
      border: 0;
      border-top: 1px solid var(--ink);
      box-shadow: none;
    }
    .promises {
      grid-template-columns: 1fr;
    }
    .promises li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px dashed var(--hairline);
      margin-top: 1.5rem;
    }
    .qa__a p {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, MQ, reduceMotion } from '../scripts/motion/core';
  import { waLink } from '../data/site';

  /* ---------------- panel entrance ---------------- */
  gsap.matchMedia().add(MQ.motion, () => {
    gsap.fromTo('[data-panel]', { clipPath: 'inset(0% 0% 100% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.4, ease: 'expo.inOut', delay: 0.1 });
  });

  /* ---------------- inquiry form → WhatsApp ---------------- */
  const form = document.querySelector<HTMLFormElement>('[data-iform]')!;
  const error = document.querySelector<HTMLElement>('[data-iform-error]')!;
  const sent = document.querySelector<HTMLElement>('[data-sent]')!;
  const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea'));

  // ?product=Polo%20T-Shirts preselects the category
  const pre = new URLSearchParams(location.search).get('product');
  const select = form.querySelector<HTMLSelectElement>('[data-product-select]')!;
  if (pre && Array.from(select.options).some((o) => o.value === pre)) select.value = pre;

  fields.forEach((f) =>
    f.addEventListener('input', () => {
      if (f.getAttribute('aria-invalid') === 'true' && f.checkValidity()) f.setAttribute('aria-invalid', 'false');
    }),
  );

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    let first: HTMLElement | null = null;
    fields.forEach((f) => {
      const bad = f instanceof HTMLInputElement && f.type === 'checkbox' ? !f.checked : !f.value.trim() || !f.checkValidity();
      f.setAttribute('aria-invalid', String(bad));
      if (bad && !first) first = f;
    });
    error.hidden = !first;
    if (first) {
      (first as HTMLElement).focus();
      return;
    }
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const msg = [
      'New wholesale inquiry - Abinaya Garment Shop',
      `Name: ${d.name}`,
      `Company: ${d.company}`,
      `Phone: ${d.phone}`,
      `Email: ${d.email}`,
      `City: ${d.city}`,
      `Product: ${d.product}`,
      `Quantity: ${d.qty}`,
      `Message: ${d.message}`,
    ].join('\n');
    window.open(waLink(msg), '_blank', 'noopener');
    form.reset();
    form.hidden = true;
    sent.hidden = false;
    sent.focus();
    if (!reduceMotion) {
      gsap
        .timeline()
        .from(sent, { y: 30, autoAlpha: 0, duration: 0.7, ease: 'expo.out' })
        .fromTo(sent.querySelectorAll('.sent__mark *'), { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.6, stagger: 0.25, ease: 'power2.out' }, 0.2);
    }
    ScrollTrigger.refresh();
  });
  document.querySelector('[data-sent-again]')!.addEventListener('click', () => {
    sent.hidden = true;
    form.hidden = false;
    fields[0].focus();
    ScrollTrigger.refresh();
  });

  /* ---------------- FAQ accordion with eased height ---------------- */
  document.querySelectorAll<HTMLDetailsElement>('[data-qa]').forEach((d) => {
    const body = d.querySelector<HTMLElement>('[data-qa-body]')!;
    d.querySelector('summary')!.addEventListener('click', (e) => {
      if (reduceMotion) return;
      e.preventDefault();
      if (d.open) {
        gsap.to(body, {
          height: 0,
          duration: 0.45,
          ease: 'power2.inOut',
          onComplete: () => {
            d.open = false;
            gsap.set(body, { clearProps: 'height' });
            ScrollTrigger.refresh();
          },
        });
      } else {
        d.open = true;
        gsap.fromTo(body, { height: 0 }, { height: 'auto', duration: 0.55, ease: 'power3.out', onComplete: () => ScrollTrigger.refresh() });
      }
    });
  });
</script>
